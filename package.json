{
  "name": "barfly",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start": "echo \"Run client or server individually\"",
    "client": "npm --workspace client run start",
    "server": "npm --workspace server run dev",
    "client:tunnel": "npm --workspace client run start:tunnel",
    "guest": "node scripts/start-guest-dev.js",
    "home": "node scripts/start-home-dev.js"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.1.3",
    "eslint": "^9.0.0",
    "prettier": "^3.2.5"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.8",
    "protobufjs": "8.4.2",
    "react-native-reanimated": "^3.19.5"
  },
  "overrides": {
    "fast-xml-parser": "^5.7.0",
    "follow-redirects": "^1.15.9",
    "postcss": "^8.5.10"
  }
}
